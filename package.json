{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.247",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:android": "npm run build:android:release",
    "build:android:debug": "node bump-version.js && tauri android build --debug --target aarch64 && node post-build.js debug",
    "build:android:release": "node bump-version.js && tauri android build --target aarch64 && node post-build.js release"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "^0.3.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "pinia": "^3.0.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}