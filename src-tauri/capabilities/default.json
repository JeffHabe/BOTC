{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability file generated by the create-tauri-app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "sharekit:default"
  ]
}
